{
  "clarify-require-tool-call": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "node ./hooks/clarify-stop-check.mjs",
        "timeout": 5
      }
    ]
  },
  "clarify-option-labels": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "ask_question",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/clarify-labels.mjs agy-pre",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
