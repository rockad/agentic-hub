{
  "jev-subagent-guard": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "bun run ./antigravity/preflight.ts",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "invoke_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "bun run ./antigravity/hook.ts pre-tool-use",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "run_command|write_file|edit_file|write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "bun run ./antigravity/guards.ts",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ask_question|invoke_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "bun run ./antigravity/hook.ts post-tool-use",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
