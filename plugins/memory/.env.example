# ── Recall Configuration ──────────────────────────────────────────────────
# Published container image tag for Basic Memory (defaults to 0.24.1)
BASIC_MEMORY_TAG=0.24.1

# Host path to the notes / memory corpus mounted into the Recall container.
# Basic Memory builds entities and semantic search over files in this corpus.
RECALL_CORPUS=~/.local/share/recall/corpus
RECALL_PORT=8110
RECALL_PROJECT=corpus

# ── Lookup Configuration ──────────────────────────────────────────────────
# Published container image, pinned by digest (no :latest). Default is the
# image built from 37f0949 (tag sha-37f0949). To update: push a `lookup-vX.Y.Z`
# tag, copy the digest from that run's summary, and set it here.
# LOOKUP_DIGEST=sha256:e9b41a0e66be47da4a9f16c809888169aab5bf7beaf39b6670a4ab561105d1cf

# Host directory or named volume for the SQLite FTS5 database (index.db).
LOOKUP_DATA=~/.local/share/lookup
LOOKUP_PORT=8100

# Base directory for relative roots declared in sources.toml
LOOKUP_HOME=/home/youruser

# Directory holding sources.toml (mounted into container at /app/manifest)
LOOKUP_MANIFEST_DIR=./servers/lookup
LOOKUP_MANIFEST_FILE=sources.toml

# Optional SMB share credentials if declared in sources.toml [source.volume]
# SHARE_USER=
# SHARE_PASS=
