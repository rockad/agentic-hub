#!/bin/sh
# a2a-doctor: checks the install of the coordination plugin and says what to do (decisions Z21 item 7,
# Z22; docs/specs/doctor.md and docs/specs/harness-keys.md). Run by hand, never as a hook.
# POSIX sh, curl, and optionally jq.
#
#   a2a-doctor [--no-network]
#
# One line per check, prefixed OK, WARN, FAIL or INFO, in sections, plain ASCII, no colour. At the end
# `a2a-doctor: N FAIL, M WARN`. Exit status: 0 when there is no FAIL, 1 when there is at least one, 2
# for a usage error. --no-network skips the server section (no request at all); -h and --help print
# the usage and exit 0.
#
# What it never does (docs/specs/doctor.md, docs/specs/harness-keys.md):
#   - edit a harness config, a settings file or a key file, or write any file at all;
#   - print a key or any part of one (text taken from a file is cleaned and any a2ak_ run is hidden
#     before it is printed, and a server's answer is never printed except a validated handle);
#   - put a key in an argument or the environment of a child (keys reach curl via `-K -` and hash
#     tools via stdin; A2A_API_KEY is unset and never read or checked);
#   - run `claude` or `agy`.
# Every curl has a connect timeout of 2 s and a limit of 5 s, so it cannot hang.
#
# It reads settings the way the hooks do: LC_ALL=C, then bin/a2a-lib.sh (a2a_load_config), so it sees
# the effective A2A_SERVER_URL, A2A_CARD, A2A_AGY_CARD, A2A_KEY_FILE and A2A_AGY_KEY_FILE.

set +x # a trace (sh -x, or SHELLOPTS set by the caller) would print the keys: never trace this script
# A2A_API_KEY is not read or checked (Z22 section 3.2 & 6); unset it so no child inherits it.
unset A2A_API_KEY
# A secret holder must not have come in through the environment: an imported variable stays exported
# when it is assigned, and would reach every child.
unset dr_ckey dr_akey dr_hkey dr_fbtok dr_atok dr_etok dr_eauth dr_mcp_key dr_pkey pr_key
unset dr_hextra dr_hmulti dr_env_keyfile dr_set_keyfile
LC_ALL=C
export LC_ALL

usage() {
  printf 'usage: a2a-doctor [--no-network]\n'
}

NO_NET=0
case $# in
  0) ;;
  1)
    case $1 in
      --no-network) NO_NET=1 ;;
      -h | --help)
        usage
        exit 0
        ;;
      *)
        usage >&2
        exit 2
        ;;
    esac
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

n_fail=0
n_warn=0
ok() { printf 'OK    %s\n' "$*"; }
info() { printf 'INFO  %s\n' "$*"; }
warn() {
  n_warn=$((n_warn + 1))
  printf 'WARN  %s\n' "$*"
}
fail() {
  n_fail=$((n_fail + 1))
  printf 'FAIL  %s\n' "$*"
}
section() { printf '\n== %s ==\n' "$1"; }

# Text that came from a file or the environment, made safe to print: printable ASCII only, any a2ak_
# run hidden, at most 200 characters.
clean() {
  printf '%s' "$1" | tr -c ' -~' '?' | sed 's/a2ak_[A-Za-z0-9_-]*/a2ak_<hidden>/g' | cut -c1-200
}

# dr_mode: the permission bits of $1 in octal, or empty when they cannot be read. GNU stat first, then
# the BSD form for macOS.
mode_of() {
  dr_mode=$(stat -c %a "$1" 2>/dev/null || stat -f %Lp "$1" 2>/dev/null)
  case $dr_mode in
    [0-7][0-7][0-7] | [0-7][0-7][0-7][0-7]) ;;
    *) dr_mode= ;;
  esac
}
# True when dr_mode has any of the bits in the octal mask $1.
mode_has() { [ $((0$dr_mode & $1)) -ne 0 ]; }

# Hash stdin without putting any secret in argv or env.
hash_stdin() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum | cut -d' ' -f1
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 | cut -d' ' -f1
  elif command -v cksum >/dev/null 2>&1; then
    cksum | tr ' ' ':'
  else
    return 1
  fi
}

# Read key from single-line file $1 into dr_hkey if it is a single line looking like an a2ak_ key;
# else dr_hkey='' (and dr_hmulti=1 when the file has more than one line).
read_key_line() {
  dr_hkey=
  dr_hmulti=0
  dr_hextra=
  {
    IFS= read -r dr_hkey || :
    if IFS= read -r dr_hextra || [ -n "$dr_hextra" ]; then
      dr_hmulti=1
    fi
  } < "$1"
  dr_hextra=
  case $dr_hkey in
    a2ak_REPLACE_WITH_YOUR_KEY) dr_hkey= ;;
    a2ak_?*)
      case $dr_hkey in
        *[!A-Za-z0-9._~+/=-]*) dr_hkey= ;;
      esac
      ;;
    *) dr_hkey= ;;
  esac
  [ "${#dr_hkey}" -le 512 ] || dr_hkey=
  if [ -z "$dr_hkey" ]; then
    dr_hmulti=0
  elif [ "$dr_hmulti" = 1 ]; then
    dr_hkey=
  fi
}

# The directory of this script, to find the lib and the other scripts next to it.
case $0 in
  */*) DIR=${0%/*} ;;
  *) DIR=. ;;
esac

# Capture A2A_KEY_FILE from the caller environment before a2a_load_config merges settings.
dr_env_keyfile=${A2A_KEY_FILE-}

LIB_OK=0
if [ -r "$DIR/a2a-lib.sh" ]; then
  # shellcheck source=/dev/null
  . "$DIR/a2a-lib.sh" && a2a_load_config && LIB_OK=1
fi

# The server URL, checked once the way the hook scripts check it (http or https, plain URL characters
# only, so a value can never turn into a curl option). The server section and the snippet use the
# result; the reason never echoes the value.
URL=${A2A_SERVER_URL:-http://127.0.0.1:8120}
URL=${URL%/}
URL_OK=0
URL_WHY=
case $URL in
  http://?* | https://?*)
    case $URL in
      *[!A-Za-z0-9._~:/@%-]*) URL_WHY="A2A_SERVER_URL has a character outside A-Za-z0-9._~:/@%- (the hooks refuse it)" ;;
      *) URL_OK=1 ;;
    esac
    ;;
  *) URL_WHY="A2A_SERVER_URL is not an http:// or https:// URL (the hooks refuse it)" ;;
esac

# ---- 1. install commands ----------------------------------------------------------------------

section "Install commands"
info "Claude Code: claude plugin marketplace add rockad/agentic-hub"
info "Claude Code: claude plugin install coordination@agentic-hub"
info "Antigravity: agy plugin install https://github.com/rockad/agentic-hub/tree/main/plugins/coordination"
info "Plugins install only from the remote main of rockad/agentic-hub: never copy or symlink the folder."

# ---- 2. plugin files --------------------------------------------------------------------------

section "Plugin files"
if [ "$LIB_OK" = 1 ]; then
  ok "a2a-lib.sh found next to a2a-doctor and loaded"
else
  fail "a2a-lib.sh not found next to a2a-doctor"
fi
for dr_f in a2a-register a2a-listen a2a-pending a2a-agy-session a2a-agy-pending; do
  if [ ! -f "$DIR/$dr_f" ]; then
    fail "$dr_f is missing next to a2a-doctor (reinstall the plugin)"
  elif [ ! -x "$DIR/$dr_f" ]; then
    fail "$dr_f is not executable (reinstall the plugin; do not chmod a copy)"
  else
    ok "$dr_f present and executable"
  fi
done
if command -v curl >/dev/null 2>&1; then
  ok "curl found (the hooks need it)"
else
  fail "curl not found (the hooks need it: install curl)"
fi
dr_ver=
if [ -r "$DIR/../plugin.json" ]; then
  if command -v jq >/dev/null 2>&1; then
    dr_ver=$(jq -r '.version // empty | strings' "$DIR/../plugin.json" 2>/dev/null | head -n 1)
  else
    dr_ver=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$DIR/../plugin.json" 2>/dev/null | head -n 1)
  fi
fi
case $dr_ver in
  '' | *[!A-Za-z0-9.+-]*) warn "plugin version not readable from ../plugin.json" ;;
  *) info "plugin version $dr_ver" ;;
esac

# ---- 3. settings file -------------------------------------------------------------------------

section "Settings file"
CFGDIR=${XDG_CONFIG_HOME:-${HOME:-/nonexistent}/.config}/a2a-coord
SFILE=${A2A_SETTINGS_FILE:-$CFGDIR/settings}
dr_p=$(clean "$SFILE")
if [ -d "$SFILE" ]; then
  fail "settings file $dr_p is a directory; the hooks ignore it (remove it, or point A2A_SETTINGS_FILE at a file)"
elif [ ! -e "$SFILE" ]; then
  info "no settings file at $dr_p (optional: the defaults and the environment apply)"
elif [ ! -f "$SFILE" ]; then
  fail "settings file $dr_p is not a regular file; the hooks ignore it"
else
  ok "settings file $dr_p exists"
  # shellcheck disable=SC3067 # -O is not in POSIX, but dash, bash and busybox all have it
  if [ ! -O "$SFILE" ]; then
    warn "settings file $dr_p is not owned by you: the hooks ignore a file you do not own"
  fi
  if [ ! -r "$SFILE" ]; then
    warn "settings file $dr_p is not readable: the hooks ignore it"
  fi
  mode_of "$SFILE"
  if [ -z "$dr_mode" ]; then
    info "settings file mode could not be read"
  elif mode_has 07177; then
    warn "settings file mode $dr_mode is wider than 600 (chmod 600 $dr_p)"
  else
    ok "settings file mode $dr_mode"
  fi
fi
dr_p=$(clean "$CFGDIR")
if [ -d "$CFGDIR" ]; then
  mode_of "$CFGDIR"
  if [ -z "$dr_mode" ]; then
    info "config directory $dr_p mode could not be read"
  elif mode_has 07077; then
    warn "config directory $dr_p mode $dr_mode is wider than 700 (chmod 700 $dr_p)"
  else
    ok "config directory $dr_p mode $dr_mode"
  fi
else
  info "no config directory at $dr_p"
fi

# ---- 4. per-harness checks (table-driven from a2a-lib.sh) -------------------------------------

KEYSDIR=$CFGDIR/keys
HAVE_JQ=0
command -v jq >/dev/null 2>&1 && HAVE_JQ=1
if [ "$URL_OK" = 1 ]; then SNIP_URL=$URL; else SNIP_URL=http://127.0.0.1:8120; fi

if [ "$LIB_OK" = 1 ] && command -v a2a_harness_table >/dev/null 2>&1; then
  dr_htable=$(a2a_harness_table)
else
  dr_htable=$(printf '%s\n' \
    'claude-code|claude-code@|keys/claude-code.key|A2A_KEY_FILE|cfg:api-key' \
    'antigravity|antigravity@|keys/antigravity.key|A2A_AGY_KEY_FILE|home:.gemini/config/mcp_config.json')
fi

dr_ckey=
dr_akey=

while IFS='|' read -r dr_hid dr_cprefix dr_canrel dr_ovname dr_fbspec; do
  [ -n "$dr_hid" ] || continue
  section "Harness: $dr_hid"

  # Keys directory mode 0700 (checked when keys/ exists)
  dr_kp=$(clean "$KEYSDIR")
  if [ -e "$KEYSDIR" ] && [ ! -d "$KEYSDIR" ]; then
    fail "$dr_hid keys directory $dr_kp is not a directory"
  elif [ -d "$KEYSDIR" ]; then
    mode_of "$KEYSDIR"
    if [ -z "$dr_mode" ]; then
      info "$dr_hid keys directory $dr_kp mode could not be read"
    elif mode_has 07077; then
      warn "$dr_hid keys directory $dr_kp mode $dr_mode is wider than 700 (chmod 700 $dr_kp)"
    else
      ok "$dr_hid keys directory $dr_kp mode $dr_mode"
    fi
  fi

  dr_ovval=
  case $dr_ovname in
    A2A_KEY_FILE) dr_ovval=${A2A_KEY_FILE:-} ;;
    A2A_AGY_KEY_FILE) dr_ovval=${A2A_AGY_KEY_FILE:-} ;;
  esac
  dr_canfile="$CFGDIR/$dr_canrel"
  case $dr_fbspec in
    cfg:*) dr_fbfile="$CFGDIR/${dr_fbspec#cfg:}" ;;
    home:*) dr_fbfile="${HOME:-/nonexistent}/${dr_fbspec#home:}" ;;
    *) dr_fbfile= ;;
  esac

  dr_src=none
  dr_kfile=$dr_canfile
  if [ -n "$dr_ovval" ]; then
    dr_src=override
    dr_kfile=$dr_ovval
  elif [ -e "$dr_canfile" ] || [ -L "$dr_canfile" ]; then
    dr_src=canonical
    dr_kfile=$dr_canfile
  elif [ "$dr_hid" = claude-code ] && [ -n "$dr_fbfile" ] && [ -e "$dr_fbfile" ] && [ ! -d "$dr_fbfile" ]; then
    dr_src=fallback
    dr_kfile=$dr_fbfile
  elif [ "$dr_hid" = antigravity ] && [ -n "$dr_fbfile" ] && [ -r "$dr_fbfile" ] && [ ! -d "$dr_fbfile" ]; then
    dr_fbtok=$(head -c 65536 "$dr_fbfile" 2>/dev/null | tr '\n' ' ' | grep -o 'a2ak_[A-Za-z0-9_-]*' | head -n 1)
    case $dr_fbtok in
      a2ak_REPLACE_WITH_YOUR_KEY) ;;
      a2ak_*_*_*)
        dr_src=fallback
        dr_kfile=$dr_fbfile
        ;;
    esac
    dr_fbtok=
  fi

  dr_p=$(clean "$dr_kfile")
  case $dr_src in
    none)
      fail "$dr_hid canonical key file $(clean "$dr_canfile") is missing. Create it yourself (the doctor never does): mkdir -p -m 700 ~/.config/a2a-coord/keys, then a mode-0600 file whose first line is the API key issued by a2a-coord key create --scope local-harness --agent ${dr_cprefix}<machine> --expires 90d"
      ;;
    fallback)
      warn "$dr_hid canonical key file $(clean "$dr_canfile") is missing; using one-release fallback $dr_p. Migrate before the next release:"
      info "mkdir -p -m 700 ~/.config/a2a-coord/keys"
      case $dr_hid in
        claude-code)
          info "mv ~/.config/a2a-coord/api-key ~/.config/a2a-coord/keys/claude-code.key"
          ;;
        antigravity)
          info "jq -r '.mcpServers[\"a2a-coord\"].headers.Authorization' ~/.gemini/config/mcp_config.json | sed 's/^Bearer //' | (umask 077; cat > ~/.config/a2a-coord/keys/antigravity.key)"
          ;;
      esac
      info "bin/a2a-doctor"
      if [ "$dr_hid" = claude-code ]; then
        if [ ! -r "$dr_kfile" ]; then
          fail "$dr_hid fallback key file $dr_p is not readable"
        else
          mode_of "$dr_kfile"
          if [ -z "$dr_mode" ]; then
            info "$dr_hid fallback key file $dr_p mode could not be read"
          elif mode_has 07177; then
            warn "$dr_hid fallback key file $dr_p mode $dr_mode is wider than 600 (chmod 600 $dr_p)"
          else
            ok "$dr_hid fallback key file $dr_p mode $dr_mode"
          fi
          read_key_line "$dr_kfile"
          if [ -n "$dr_hkey" ]; then
            ok "$dr_hid fallback key file first line looks like an a2a key"
            dr_ckey=$dr_hkey
          elif [ "$dr_hmulti" = 1 ]; then
            fail "$dr_hid fallback key file $dr_p has more than one line (only a single line with the a2a key is allowed)"
          else
            fail "$dr_hid fallback key file $dr_p first line does not look like an a2a key (a2ak_ followed by key characters only; check for a blank first line, a CRLF line ending or a stray space)"
          fi
          dr_hkey=
        fi
      fi
      ;;
    canonical | override)
      if [ -d "$dr_kfile" ]; then
        fail "$dr_hid key file $dr_p is a directory (it must be a file)"
      elif [ ! -e "$dr_kfile" ]; then
        fail "$dr_hid key file $dr_p is missing"
      elif [ ! -r "$dr_kfile" ]; then
        fail "$dr_hid key file $dr_p is not readable"
      else
        mode_of "$dr_kfile"
        if [ -z "$dr_mode" ]; then
          info "$dr_hid key file $dr_p mode could not be read"
        elif mode_has 07177; then
          warn "$dr_hid key file $dr_p mode $dr_mode is wider than 600 (chmod 600 $dr_p)"
        else
          ok "$dr_hid key file $dr_p mode $dr_mode"
        fi
        read_key_line "$dr_kfile"
        if [ -n "$dr_hkey" ]; then
          ok "$dr_hid key file first line looks like an a2a key"
          case $dr_hid in
            claude-code) dr_ckey=$dr_hkey ;;
            antigravity) dr_akey=$dr_hkey ;;
          esac
        elif [ "$dr_hmulti" = 1 ]; then
          fail "$dr_hid key file $dr_p has more than one line (only a single line with the a2a key is allowed)"
        else
          fail "$dr_hid key file $dr_p first line does not look like an a2a key (a2ak_ followed by key characters only; check for a blank first line, a CRLF line ending or a stray space)"
        fi
        dr_hkey=
      fi
      ;;
  esac

  # Harness-specific MCP checks
  case $dr_hid in
    claude-code)
      if [ -n "$dr_env_keyfile" ]; then
        dr_set_keyfile=
        if [ "$LIB_OK" = 1 ]; then
          dr_set_keyfile=$(unset A2A_KEY_FILE; a2a_load_config; printf '%s' "${A2A_KEY_FILE:-}")
        fi
        if [ "$dr_env_keyfile" != "$dr_set_keyfile" ]; then
          warn "A2A_KEY_FILE is set in the shell environment without matching ~/.config/a2a-coord/settings: Claude Code strips *KEY* env vars from headersHelper, so place the A2A_KEY_FILE override in ~/.config/a2a-coord/settings"
        fi
        dr_set_keyfile=
      fi
      dr_cmcp="$DIR/../claude/mcp.json"
      if [ ! -r "$dr_cmcp" ]; then
        fail "claude/mcp.json is missing or unreadable (reinstall the plugin)"
      elif [ "$HAVE_JQ" = 1 ]; then
        if ! jq -e 'type == "object"' "$dr_cmcp" >/dev/null 2>&1; then
          fail "claude/mcp.json is not valid JSON"
        else
          dr_hh=$(jq -r 'try (.mcpServers["a2a-coord"].headersHelper) catch null | strings' "$dr_cmcp" 2>/dev/null | head -n 1)
          case $dr_hh in
            *bin/a2a-mcp-headers | *bin/a2a-mcp-headers'"') ok "claude/mcp.json declares headersHelper pointing to bin/a2a-mcp-headers" ;;
            *) fail "claude/mcp.json does not declare headersHelper pointing to bin/a2a-mcp-headers" ;;
          esac
        fi
      else
        if grep -Eq '"headersHelper"[[:space:]]*:[[:space:]]*"([^"]|\\")*bin/a2a-mcp-headers(\\")?"' "$dr_cmcp" 2>/dev/null; then
          ok "claude/mcp.json declares headersHelper pointing to bin/a2a-mcp-headers"
        else
          fail "claude/mcp.json does not declare headersHelper pointing to bin/a2a-mcp-headers"
        fi
      fi
      if [ ! -f "$DIR/a2a-mcp-headers" ]; then
        fail "bin/a2a-mcp-headers is missing (reinstall the plugin)"
      elif [ ! -x "$DIR/a2a-mcp-headers" ]; then
        fail "bin/a2a-mcp-headers is not executable (reinstall the plugin; do not chmod a copy)"
      else
        mode_of "$DIR/a2a-mcp-headers"
        if [ -z "$dr_mode" ]; then
          ok "bin/a2a-mcp-headers present and executable (mode could not be read)"
        elif [ "$dr_mode" = 755 ] || [ "$dr_mode" = 0755 ]; then
          ok "bin/a2a-mcp-headers present and executable (mode $dr_mode)"
        else
          warn "bin/a2a-mcp-headers is executable but mode $dr_mode is not 0755"
        fi
      fi
      ;;
    antigravity)
      AGYFILE=${HOME:-/nonexistent}/.gemini/config/mcp_config.json
      OLDAGY=${HOME:-/nonexistent}/.gemini/config/plugins/coordination/mcp_config.json
      dr_p=$(clean "$AGYFILE")
      dr_usable=0
      dr_entry=0
      dr_json=0
      dr_atok=
      dr_etok=
      dr_eauth=
      dr_mcp_key=

      if [ -d "$AGYFILE" ]; then
        fail "agy file $dr_p is a directory (it must be a file)"
      elif [ ! -e "$AGYFILE" ]; then
        warn "agy entry not set up: $dr_p does not exist (add the snippet below)"
      elif [ ! -r "$AGYFILE" ]; then
        warn "agy file $dr_p is not readable"
      else
        dr_usable=1
      fi
      if [ "$dr_usable" = 1 ]; then
        mode_of "$AGYFILE"
        if [ -z "$dr_mode" ]; then
          info "agy file mode could not be read"
        elif mode_has 07177; then
          warn "agy file $dr_p mode $dr_mode is wider than 600; it holds a key (chmod 600 $dr_p)"
        else
          ok "agy file $dr_p mode $dr_mode"
        fi
        if [ "$HAVE_JQ" = 1 ]; then
          if jq -e 'type == "object"' "$AGYFILE" >/dev/null 2>&1; then
            dr_json=1
          else
            warn "agy file $dr_p is not a valid JSON object: agy will not load it"
          fi
        else
          info "jq is not installed: the agy entry is checked by text search, the url and header checks are skipped"
        fi
        if [ "$dr_json" = 1 ]; then
          if jq -e 'try ((.mcpServers | type == "object") and (.mcpServers | has("a2a-coord"))) catch false' "$AGYFILE" >/dev/null 2>&1; then
            dr_entry=1
          fi
        elif head -c 65536 "$AGYFILE" 2>/dev/null | grep -q '"a2a-coord"'; then
          dr_entry=1
        fi
        dr_atok=$(head -c 65536 "$AGYFILE" 2>/dev/null | tr '\n' ' ' | grep -o 'a2ak_[A-Za-z0-9_-]*' | head -n 1)
        dr_tok_state=none
        case $dr_atok in
          '') ;;
          a2ak_REPLACE_WITH_YOUR_KEY) dr_tok_state=placeholder ;;
          a2ak_*_*_*) dr_tok_state=good ;;
          *) dr_tok_state=malformed ;;
        esac
        if [ "$dr_entry" = 0 ]; then
          warn "agy entry not set up: $dr_p has no a2a-coord server entry (add the snippet below by hand)"
        else
          ok "agy file has an a2a-coord server entry"
          case $dr_tok_state in
            good) ok "agy file holds an a2ak_ key" ;;
            placeholder) fail "agy file still holds the placeholder key from the snippet: replace it with your key" ;;
            malformed) fail "agy file holds an a2ak_ token that is not of the form a2ak_<env>_<keyid>_<secret>" ;;
            *) fail "agy file has an a2a-coord entry but no a2ak_ key: put your key in the Authorization header" ;;
          esac
          if [ "$dr_json" = 1 ]; then
            dr_eurl=$(jq -r 'try (.mcpServers["a2a-coord"].url // .mcpServers["a2a-coord"].serverUrl) catch null | strings' "$AGYFILE" 2>/dev/null | head -n 1)
            if [ "$URL_OK" = 1 ]; then
              if [ "$dr_eurl" = "$URL/mcp" ]; then
                ok "agy entry url is $URL/mcp"
              else
                warn "agy entry url is not $URL/mcp, the effective server URL plus /mcp (the entry's own value is not shown)"
              fi
            fi
            dr_eauth=$(jq -r 'try (.mcpServers["a2a-coord"].headers.Authorization) catch null | strings' "$AGYFILE" 2>/dev/null | head -n 1)
            if [ -z "$dr_eauth" ]; then
              warn "agy entry has no Authorization header: the agy tools will answer 401"
            else
              ok "agy entry has an Authorization header"
              dr_etok=$(printf '%s' "$dr_eauth" | grep -o 'a2ak_[A-Za-z0-9_-]*' | head -n 1)
              if [ -n "$dr_etok" ] && [ -n "$dr_atok" ] && [ "$dr_etok" != "$dr_atok" ]; then
                warn "the first a2ak_ key in the agy file is not the one in the a2a-coord entry"
              fi
            fi
          fi
        fi

        if [ "$dr_src" = fallback ] && [ "$dr_tok_state" = good ]; then
          dr_akey=$dr_atok
        fi

        if [ "$dr_src" != fallback ] && [ -n "$dr_akey" ] && [ "$dr_entry" = 1 ]; then
          if [ "$dr_json" = 1 ] && [ -n "$dr_etok" ]; then
            dr_mcp_key=$dr_etok
          elif [ "$dr_tok_state" = good ]; then
            dr_mcp_key=$dr_atok
          fi
          if [ -n "$dr_mcp_key" ]; then
            dr_h1=$(printf '%s' "$dr_akey" | hash_stdin) || dr_h1=
            dr_h2=$(printf '%s' "$dr_mcp_key" | hash_stdin) || dr_h2=
            if [ -z "$dr_h1" ] || [ -z "$dr_h2" ]; then
              info "antigravity key hash comparison skipped: no sha256sum, shasum, or cksum available"
            elif [ "$dr_h1" = "$dr_h2" ]; then
              ok "antigravity key file and mcp_config.json literal match"
            else
              warn "antigravity key file and mcp_config.json literal differ (copy the current key to both places during rotation)"
            fi
            dr_h1=
            dr_h2=
          fi
        fi
        dr_atok=
        dr_etok=
        dr_eauth=
        dr_mcp_key=

        # Orphans: other servers of ours in the same file.
        if [ "$dr_json" = 1 ]; then
          dr_names=$(jq -r 'try (.mcpServers | keys[] | select(startswith("a2a-") and . != "a2a-coord")) catch empty' "$AGYFILE" 2>/dev/null)
        else
          dr_names=$(head -c 65536 "$AGYFILE" 2>/dev/null | tr '\n' ' ' | grep -o '"a2a-[A-Za-z0-9._-]*"' | sort -u | grep -v '^"a2a-coord"$' | tr -d '"')
        fi
        if [ -n "$dr_names" ]; then
          dr_names=$(printf '%s\n' "$dr_names" | head -n 5 | tr '\n' ' ')
          warn "orphan entry in $dr_p besides a2a-coord: $(clean "$dr_names")(remove it by hand; the plugin never edits the file)"
        fi
      fi
      if [ -e "$OLDAGY" ] || [ -L "$OLDAGY" ]; then
        warn "orphan file from before Z20: $(clean "$OLDAGY") (a second a2a server entry that may hold a key; delete it by hand, the doctor never does)"
      fi
      info "agy MCP snippet (merge it into the existing mcpServers object of $dr_p by hand, keep the file mode 0600; the plugin never edits it):"
      info "{\"mcpServers\": {\"a2a-coord\": {\"type\": \"http\", \"url\": \"$SNIP_URL/mcp\", \"headers\": {\"Authorization\": \"Bearer a2ak_REPLACE_WITH_YOUR_KEY\"}}}}"
      ;;
  esac
done <<EOF
$dr_htable
EOF

# ---- 5. server --------------------------------------------------------------------------------

# probe LABEL CARD KEY: register a probe session as the hook would, report, and end it again. The
# key goes to curl on stdin; neither the key nor any server text but a validated handle is printed.
probe() {
  pr_label=$1
  pr_card=$2
  pr_key=$3
  pr_body=$(printf '{"card":"%s","harness_session_id":"doctor-%s"}' "$pr_card" "$$")
  pr_resp=$(printf 'header = "Authorization: Bearer %s"\n' "$pr_key" |
    curl -q -sS --proto '=http,https' --noproxy '*' --connect-timeout 2 --max-time 5 --max-filesize 65536 -K - -X POST \
      -H 'Content-Type: application/json' -H 'Accept: application/json' \
      --data "$pr_body" -w '\n%{http_code}' "$URL/sessions" 2>/dev/null)
  pr_code=$(printf '%s' "$pr_resp" | tail -n 1)
  case $pr_code in
    [0-9][0-9][0-9]) ;;
    *) pr_code=000 ;;
  esac
  case $pr_code in
    200 | 201)
      pr_json=$(printf '%s' "$pr_resp" | sed '$d' | tr '\n\r\t' '   ')
      pr_rest=${pr_json#*\"handle\"}
      pr_handle=
      if [ "$pr_rest" != "$pr_json" ]; then
        pr_handle=$(printf '%s' "$pr_rest" | sed -n 's/^[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p;q')
      fi
      # The handle grammar of server-api.md 5.1, and it must be this card's.
      if printf '%s' "$pr_handle" | grep -Eq '^[a-z0-9][a-z0-9-]{0,31}@[a-z0-9][a-z0-9-]{0,31}/[a-z0-9][a-z0-9._-]{0,38}~[0-9a-f]{8}$'; then
        case $pr_handle in
          "$pr_card"/*)
            ok "$pr_label key accepted: registered as $pr_handle"
            pr_ecode=$(printf 'header = "Authorization: Bearer %s"\n' "$pr_key" |
              curl -q -sS --proto '=http,https' --noproxy '*' --connect-timeout 2 --max-time 5 --max-filesize 65536 -K - -X POST \
                -H 'Content-Type: application/json' -o /dev/null -w '%{http_code}' \
                --data "$pr_body" "$URL/sessions/end" 2>/dev/null)
            case $pr_ecode in
              200 | 204) info "$pr_label probe session ended" ;;
              *) info "$pr_label probe session could not be ended (status $(clean "$pr_ecode")); it ends by itself when idle" ;;
            esac
            pr_key=
            return 0
            ;;
        esac
      fi
      fail "$pr_label registration answered $pr_code but not with a valid handle for card $(clean "$pr_card")"
      ;;
    401 | 403) fail "the server rejected the $pr_label key (status $pr_code): expired or revoked, run key rotate" ;;
    000) fail "$pr_label registration: no answer from $URL" ;;
    *) fail "$pr_label registration failed with status $pr_code" ;;
  esac
  pr_key=
  return 0
}

section "Server"
HEALTH_OK=0
if [ "$URL_OK" = 0 ]; then
  fail "$URL_WHY; the network checks are skipped"
elif [ "$NO_NET" = 1 ]; then
  info "server checks skipped (--no-network); effective server URL $URL"
elif ! command -v curl >/dev/null 2>&1; then
  fail "no curl: the server checks are skipped"
else
  info "effective server URL $URL"
  dr_code=$(curl -q -sS --proto '=http,https' --noproxy '*' --connect-timeout 2 --max-time 5 -o /dev/null -w '%{http_code}' "$URL/healthz" 2>/dev/null </dev/null)
  case $dr_code in
    200)
      ok "GET $URL/healthz answered 200"
      HEALTH_OK=1
      ;;
    000 | '') fail "GET $URL/healthz: no answer (is the stack up? it runs under plugins/coordination with docker compose up)" ;;
    [0-9][0-9][0-9]) fail "GET $URL/healthz answered $dr_code, not 200 (is the stack up? it runs under plugins/coordination with docker compose up)" ;;
    *) fail "GET $URL/healthz: no answer (is the stack up? it runs under plugins/coordination with docker compose up)" ;;
  esac
fi

if [ "$HEALTH_OK" = 1 ]; then
  dr_nl='
'
  while IFS='|' read -r dr_hid dr_cprefix _; do
    [ -n "$dr_hid" ] || continue
    dr_card=
    dr_pkey=
    dr_cardok=0
    case $dr_hid in
      claude-code)
        dr_pkey=$dr_ckey
        dr_card=${A2A_CARD:-}
        if [ -z "$dr_card" ]; then
          dr_h=$(uname -n 2>/dev/null)
          dr_h=${dr_h%%.*}
          dr_h=$(printf '%s' "$dr_h" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-' '-' | cut -c1-32)
          while :; do
            case $dr_h in
              -*) dr_h=${dr_h#-} ;;
              *) break ;;
            esac
          done
          dr_card="${dr_cprefix}$dr_h"
        fi
        if [ -n "$dr_pkey" ]; then
          case $dr_card in
            *"$dr_nl"*) dr_cardok=0 ;;
            *) if printf '%s' "$dr_card" | grep -Eq '^[a-z0-9][a-z0-9-]{0,31}@[a-z0-9][a-z0-9-]{0,31}$'; then dr_cardok=1; else dr_cardok=0; fi ;;
          esac
        fi
        ;;
      antigravity)
        dr_pkey=$dr_akey
        dr_card=${A2A_AGY_CARD:-}
        if [ -z "$dr_card" ]; then
          dr_m=$(uname -n 2>/dev/null | cut -d. -f1 | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9\n-' '-' | head -c 32)
          dr_card="${dr_cprefix}$dr_m"
        fi
        if [ -n "$dr_pkey" ]; then
          case $dr_card in
            antigravity@*)
              dr_m=${dr_card#antigravity@}
              case $dr_m in
                '' | [!a-z0-9]* | *[!a-z0-9-]*) ;;
                *) [ "${#dr_m}" -le 32 ] && dr_cardok=1 ;;
              esac
              ;;
          esac
        fi
        ;;
    esac

    if [ -z "$dr_pkey" ]; then
      info "$dr_hid probe skipped: no usable $dr_hid key"
    elif [ "$dr_cardok" = 1 ]; then
      info "$dr_hid card $dr_card"
      probe "$dr_hid" "$dr_card" "$dr_pkey"
    else
      case $dr_hid in
        claude-code) fail "$dr_hid card $(clean "$dr_card") is not a valid card (harness@machine, lowercase letters, digits and hyphens): the hooks stay silent; set A2A_CARD" ;;
        antigravity) fail "$dr_hid card $(clean "$dr_card") is not a valid card (antigravity@machine, lowercase letters, digits and hyphens): the agy hooks stay silent; set A2A_AGY_CARD" ;;
      esac
    fi
    dr_pkey=
  done <<EOF
$dr_htable
EOF
elif [ "$URL_OK" = 1 ] && [ "$NO_NET" = 0 ]; then
  info "probe sessions skipped: the health check did not pass"
fi

dr_ckey=
dr_akey=

# ---- 6. summary -------------------------------------------------------------------------------

printf '\na2a-doctor: %s FAIL, %s WARN\n' "$n_fail" "$n_warn"
[ "$n_fail" -eq 0 ]
exit $?
